# Copy this file to .dev.vars for local development (it is git-ignored).
# In production, add each value with: npx wrangler secret put NAME

# Sign-in (Supabase → Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional: your public address, e.g. https://miseora.com (defaults to the address the site is served from)
SITE_URL=

# Optional: AI recipe ideas (OpenAI API). Leave empty to hide the AI buttons.
OPENAI_API_KEY=

# Owner dashboard: your account id, shown on the /setup page after you sign in
ADMIN_USER_ID=
SUPPORT_EMAIL=

# Payments (Stripe) — leave empty until you are ready
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PLUS_PRICE_LABEL=
