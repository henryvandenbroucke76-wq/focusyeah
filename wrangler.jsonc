// Cloudflare Workers settings for Miseora.
// Secrets (API keys) are not stored here: add them with `npx wrangler secret put NAME`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miseora",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miseora-db",
      // Replace with the id printed by `npx wrangler d1 create miseora-db`.
      "database_id": "2b07a9d2-9e5b-4318-8a85-281c48dc02d9",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "miseora-uploads"
    }
  ],
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini",
    "BILLING_ENABLED": "false",
    "AUTH_GOOGLE_ENABLED": "false",
    "AUTH_APPLE_ENABLED": "false"
  }
}
